{
  "name": "galaxy-ai-desktop",
  "productName": "galaxy ai",
  "version": "0.8.25",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc -b && vite build",
    "package:win": "npm run build && electron-builder --win --dir",
    "package:installer": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "bootstrap": "^5.3.8",
    "lucide-react": "^0.468.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "19.3.1",
    "siriwave": "2.4.0",
    "streamdown": "^2.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "^5.9.0",
    "vite": "8.3.6"
  },
  "build": {
    "appId": "com.galaxy.ai",
    "productName": "galaxy ai",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "dir",
      "executableName": "GalaxyAI",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "galaxy ai",
      "uninstallDisplayName": "galaxy ai",
      "deleteAppDataOnUninstall": false,
      "artifactName": "galaxy-ai-Setup-${version}.${ext}"
    }
  },
  "description": "galaxy ai Windows workspace"
}
